{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/package.json"
      ],
      "matchDepTypes": [
        "dependencies",
        "devDependencies",
        "optionalDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "frontend non-major dependencies",
      "groupSlug": "frontend-non-major"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres"
      ],
      "groupName": "PostgreSQL container images",
      "groupSlug": "postgres-images"
    },
    {
      "description": "Keep Temurin on approved Java 25 LTS; change only after an explicit LTS-major upgrade request and official support check.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "eclipse-temurin",
        "library/eclipse-temurin",
        "docker.io/library/eclipse-temurin"
      ],
      "allowedVersions": "/^25([.-]|$)/"
    }
  ],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5
}
